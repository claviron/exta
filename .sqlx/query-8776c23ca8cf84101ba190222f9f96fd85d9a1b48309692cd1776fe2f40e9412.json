  "query": "\n            SELECT uuid, from_user_id, to_user_id, content, created_at, delivered_at, read_at\n            FROM chat.private_messages\n            WHERE (from_user_id = $1 AND to_user_id = $2)\n               OR (from_user_id = $2 AND to_user_id = $1)\n            ORDER BY created_at DESC\n            LIMIT $3\n            ",
