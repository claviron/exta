  "query": "\n            SELECT uuid, room, from_user_id, content, created_at\n            FROM chat.room_messages\n            WHERE room = $1\n              AND to_tsvector('english', content) @@ plainto_tsquery('english', $2)\n            ORDER BY created_at DESC\n            LIMIT $3\n            ",
